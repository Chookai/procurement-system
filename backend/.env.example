# Synthetic, loopback-only development services. Never use these credentials in Azure.
DATABASE_URL=postgresql://procurement:procurement-local-only@127.0.0.1:15432/procurement
BLOB_ENDPOINT=http://127.0.0.1:14577/devstoreaccount1
# Supply only in ignored backend/.env, or as an environment variable.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Initial contract-test candidates; not quality-certified release models.
OPENROUTER_CHAT_MODEL=openai/gpt-4.1-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_PROVIDER=openai
